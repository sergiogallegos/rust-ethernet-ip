<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Version Information -->
    <Version>0.6.3</Version>
    <AssemblyVersion>0.6.3.0</AssemblyVersion>
    <FileVersion>0.6.3.0</FileVersion>
    <Product>Rust EtherNet/IP WinForms Example</Product>
    <Description>WinForms example application demonstrating the Rust EtherNet/IP 0.7.0 hardening line with batch operations, subscriptions, and diagnostics</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\csharp\RustEtherNetIp\RustEtherNetIp.csproj" />
  </ItemGroup>

</Project> 
