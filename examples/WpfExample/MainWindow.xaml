<Window x:Class="WpfExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfExample.ViewModels"
        xmlns:local="clr-namespace:WpfExample"
        xmlns:converters="clr-namespace:WpfExample.Converters"
        Title="🦀 Rust EtherNet/IP - Comprehensive Demo (0.7.0 Hardening)" 
        Height="1000" Width="1900"
        MinHeight="1000" MinWidth="1900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <!-- Inverted Boolean Converter -->
        <converters:InvertedBooleanConverter x:Key="InvertedBoolConverter"/>
    </Window.Resources>
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                CornerRadius="6" Padding="20" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1A000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                          Text="🦀 Rust EtherNet/IP - WPF Demo"
                          FontSize="24" FontWeight="Bold" 
                          Foreground="{StaticResource PrimaryBrush}"/>
                
                <!-- Connection Controls -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="PLC Address:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding PlcAddress}" Width="200" Padding="8,4">
                            <TextBox.IsEnabled>
                                <Binding Path="IsConnected" Converter="{StaticResource InvertedBoolConverter}"/>
                            </TextBox.IsEnabled>
                        </TextBox>
                        <CheckBox Content="Use Route Path (Required)" IsChecked="{Binding UseRoutePath}" 
                                  VerticalAlignment="Center" Margin="16,0,8,0">
                            <CheckBox.IsEnabled>
                                <Binding Path="IsConnected" Converter="{StaticResource InvertedBoolConverter}"/>
                            </CheckBox.IsEnabled>
                        </CheckBox>
                        <TextBlock Text="CPU Slot:" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock.IsEnabled>
                                <Binding Path="UseRoutePath"/>
                            </TextBlock.IsEnabled>
                        </TextBlock>
                        <TextBox Text="{Binding CpuSlot}" Width="50" Padding="4,2" VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsConnected}" Value="False"/>
                                                <Condition Binding="{Binding UseRoutePath}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" 
                                Style="{StaticResource SuccessButton}">
                            <Button.IsEnabled>
                                <Binding Path="IsConnected" Converter="{StaticResource InvertedBoolConverter}"/>
                            </Button.IsEnabled>
                        </Button>
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" 
                                Style="{StaticResource ErrorButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding IsConnected}"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Status -->
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
                           Orientation="Vertical" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Bold" FontSize="16">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding SessionId, StringFormat='Session: \{0\}'}" FontSize="12" Opacity="0.7"/>    
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Performance Info -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                CornerRadius="6" Padding="20" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1A000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📊 Read Rate:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ReadRate, StringFormat={}{0} ops/sec}" 
                                FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="📝 Write Rate:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding WriteRate, StringFormat={}{0} ops/sec}" 
                                FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="Run Benchmark" 
                        Command="{Binding RunBenchmarkCommand}"
                        Style="{StaticResource ModernButton}"
                        IsEnabled="{Binding IsConnected}"/>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="2">
            <TabControl>
                <!-- Individual Operations Tab -->
                <TabItem Header="📋 Individual Operations">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Panel: Tag Monitoring -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="20" Margin="0,0,8,0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#1A000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.08"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Tag Monitor Title -->
                                <TextBlock Grid.Row="0" Text="📊 Tag Monitoring" 
                                           FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <!-- Current release-line notice -->
                                <Border Background="#D4EDDA" BorderBrush="#C3E6CB" BorderThickness="1" 
                                        CornerRadius="4" Padding="8" Margin="0,0,0,16">
                                    <TextBlock Text="✅ Current status: stable release is 0.6.3, 0.7.0 is in hardening. STRING support, subscriptions, route-path operations, and batch read/write/execute are available."
                                               FontSize="12" Foreground="#155724" TextWrapping="Wrap"/>
                                </Border>
                                
                                <!-- Tag Discovery -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tag Discovery Controls -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding TagToDiscover}" Width="200" Padding="8,4" Margin="0,0,8,0"/>
                                        <Button Content="Discover Tag" Command="{Binding DiscoverTagCommand}"
                                                Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                                        <Button Content="Create Test Tags" Command="{Binding CreateTestTagsCommand}"
                                                Style="{StaticResource SuccessButton}"
                                                IsEnabled="{Binding IsConnected}"/>
                                    </StackPanel>

                                    <!-- Tag Operations -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBox Text="{Binding TagName}" Width="200" Padding="8,4" Margin="0,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding SelectedDataType}" 
                                                      Width="100" Padding="8,4" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding TagValue}" Width="100" Padding="8,4"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1" Content="Read" Command="{Binding ReadTagCommand}"
                                                Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Write" Command="{Binding WriteTagCommand}"
                                                Style="{StaticResource ModernButton}"/>
                                    </Grid>

                                    <!-- Tags DataGrid -->
                                    <DataGrid Grid.Row="2" ItemsSource="{Binding Tags}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                              Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tag Name" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="Auto"/>
                                            <DataGridTextColumn Header="Updated" 
                                                              Binding="{Binding LastUpdated, StringFormat='HH:mm:ss'}" Width="Auto"/>
                                        </DataGrid.Columns>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <!-- Right Panel: Activity Log -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="20" Margin="8,0,0,0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#1A000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.08"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Log Title -->
                                <TextBlock Grid.Row="0" Text="📝 Activity Log" 
                                           FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                                
                                <!-- Log ListBox -->
                                <ListBox Grid.Row="1" ItemsSource="{Binding LogMessages}"
                                         Background="{StaticResource SurfaceLightBrush}" 
                                         Foreground="{StaticResource TextPrimaryBrush}" 
                                         FontFamily="Consolas" FontSize="12"
                                         BorderThickness="0" Padding="8">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Array Tests Tab -->
                <TabItem Header="📊 Array Tests">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Array Read Section -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="📖 Read Array Element" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Tag Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding ArrayTagName}" Width="300" Padding="8,4" Margin="0,0,8,0"/>
                                    <Button Content="Read" Command="{Binding ReadArrayElementCommand}"
                                            Style="{StaticResource ModernButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Row="2" Text="{Binding ArrayReadValue}" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Grid>
                        </Border>
                        
                        <!-- Array Write Section -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="✏️ Write Array Element" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="Tag Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding ArrayTagName}" Width="200" Padding="8,4" Margin="0,0,8,0"/>
                                    <TextBlock Text="Value:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding ArrayWriteValue}" Width="100" Padding="8,4" Margin="0,0,8,0"/>
                                    <Button Content="Write" Command="{Binding WriteArrayElementCommand}"
                                            Style="{StaticResource WarningButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Results -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="📊 Results" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding ArrayResult}" 
                                               FontFamily="Consolas" FontSize="12" 
                                               TextWrapping="Wrap"
                                               Background="{StaticResource SurfaceLightBrush}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" Padding="8"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- UDT Tests Tab -->
                <TabItem Header="🏗️ UDT Tests">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- UDT Read Section -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="📖 Read Full UDT" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="Tag Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding UdtTagName}" Width="300" Padding="8,4" Margin="0,0,8,0"/>
                                    <Button Content="Read UDT" Command="{Binding ReadUdtCommand}"
                                            Style="{StaticResource ModernButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- UDT Member Read Section -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="📖 Read UDT Member" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Member Path:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding UdtMemberPath}" Width="300" Padding="8,4" Margin="0,0,8,0"/>
                                    <Button Content="Read Member" Command="{Binding ReadUdtMemberCommand}"
                                            Style="{StaticResource ModernButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Row="2" Text="{Binding UdtMemberReadValue}" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Grid>
                        </Border>
                        
                        <!-- UDT Member Write Section -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="✏️ Write UDT Member" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="Member Path:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding UdtMemberPath}" Width="200" Padding="8,4" Margin="0,0,8,0"/>
                                    <TextBlock Text="Value:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding UdtMemberWriteValue}" Width="100" Padding="8,4" Margin="0,0,8,0"/>
                                    <Button Content="Write Member" Command="{Binding WriteUdtMemberCommand}"
                                            Style="{StaticResource WarningButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Results -->
                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="📊 Results" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding UdtResult}" 
                                               FontFamily="Consolas" FontSize="12" 
                                               TextWrapping="Wrap"
                                               Background="{StaticResource SurfaceLightBrush}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" Padding="8"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- STRING Operations Tab -->
                <TabItem Header="📝 STRING Operations">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Limitations Notice -->
                        <Border Grid.Row="0" Background="#FFFBF7" BorderBrush="#FCD34D" BorderThickness="1" 
                                CornerRadius="4" Padding="8" Margin="0,0,0,16">
                            <TextBlock Text="⚠️ PLC LIMITATIONS: STRING tags cannot be written directly due to PLC firmware restrictions (CIP Error 0x2107).&#x0a;✅ STRING tags CAN be read successfully.&#x0a;💡 Workaround: If STRING is part of a UDT, read entire UDT, modify STRING member, then write entire UDT back."
                                       FontSize="12" Foreground="#A16207" TextWrapping="Wrap"/>
                        </Border>
                        
                        <!-- STRING Read Section -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="📖 Read STRING Tag" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Tag Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding StringReadTagName}" Width="300" Padding="8,4" Margin="0,0,8,0"/>
                                    <Button Content="Read STRING" Command="{Binding ReadStringCommand}"
                                            Style="{StaticResource ModernButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Row="2" Text="{Binding StringReadResult}" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Grid>
                        </Border>
                        
                        <!-- STRING Write Section -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="✏️ Write STRING Tag (PLC Limitation)" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Tag Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding StringWriteTagName}" Width="200" Padding="8,4" Margin="0,0,8,0"/>
                                    <TextBlock Text="Value:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding StringWriteValue}" Width="200" Padding="8,4" Margin="0,0,8,0"/>
                                    <Button Content="Write STRING (Will Fail)" Command="{Binding WriteStringCommand}"
                                            Style="{StaticResource ErrorButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Row="2" Text="{Binding StringWriteResult}" 
                                           FontSize="12" 
                                           Foreground="{StaticResource ErrorBrush}"/>
                            </Grid>
                        </Border>
                        
                        <!-- LogixString Helper Section -->
                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="💡 LogixString Helper (For UDT STRING Members)" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <TextBlock Grid.Row="1" Text="{Binding LogixStringExample}" 
                                           FontFamily="Consolas" FontSize="12" 
                                           TextWrapping="Wrap"
                                           Background="{StaticResource SurfaceLightBrush}" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Padding="8"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Tag Group Tab -->
                <TabItem Header="🔄 Tag Group">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Tag Group Configuration -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="🔄 Tag Group Configuration" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Tag Names (one per line):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding TagGroupTagNames}" Width="400" Height="80" 
                                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"/>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Update Rate (ms):" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding TagGroupUpdateRate}" Width="100" Padding="4,2"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="Start" Command="{Binding TagGroupStartCommand}"
                                            Style="{StaticResource SuccessButton}" Margin="0,0,8,0"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Stop" Command="{Binding TagGroupStopCommand}"
                                            Style="{StaticResource ErrorButton}" Margin="0,0,8,0"
                                            IsEnabled="{Binding IsTagGroupActive}"/>
                                    <Button Content="Suspend" Command="{Binding TagGroupSuspendCommand}"
                                            Style="{StaticResource WarningButton}" Margin="0,0,8,0"
                                            IsEnabled="{Binding IsTagGroupActive}"/>
                                    <Button Content="Resume" Command="{Binding TagGroupResumeCommand}"
                                            Style="{StaticResource SuccessButton}"
                                            IsEnabled="{Binding IsTagGroupSuspended}"/>
                                    <TextBlock Text="{Binding TagGroupStatus}" Margin="16,0,0,0" 
                                               VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Tag Group Values -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="Tag Group Values" 
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TagGroupValues}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tag Name" Binding="{Binding TagName}" Width="*"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto"/>
                                        <DataGridTextColumn Header="Last Updated" 
                                                          Binding="{Binding LastUpdated, StringFormat='HH:mm:ss'}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Statistics Tab -->
                <TabItem Header="📊 Statistics">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Read Count" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding StatisticsReadCount, StringFormat={}{0:N0}}" 
                                               FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Write Count" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding StatisticsWriteCount, StringFormat={}{0:N0}}" 
                                               FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Error Count" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding StatisticsErrorCount, StringFormat={}{0:N0}}" 
                                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Avg Response Time" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Text="{Binding StatisticsAvgResponseTime, StringFormat={}{0:F2} ms}" 
                                               FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <Button Grid.Column="4" Content="Reset" Command="{Binding ResetStatisticsCommand}"
                                        Style="{StaticResource ModernButton}"
                                        IsEnabled="{Binding IsConnected}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Batch Operations Tab -->
                <TabItem Header="🚀 Batch Operations">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Batch Read Section -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="🚀 Batch Read Operations" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Enter tag names (one per line):" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding BatchReadTags}" Height="80" TextWrapping="Wrap" 
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                <Button Content="🚀 Execute Batch Read" Command="{Binding ExecuteBatchReadCommand}"
                                        Style="{StaticResource SuccessButton}" Margin="0,8,0,0"
                                        IsEnabled="{Binding IsConnected}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Batch Write Section -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="✏️ Batch Write Operations" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Enter tag=value pairs (one per line):" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding BatchWriteTags}" Height="80" TextWrapping="Wrap" 
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                <Button Content="✏️ Execute Batch Write" Command="{Binding ExecuteBatchWriteCommand}"
                                        Style="{StaticResource WarningButton}" Margin="0,8,0,0"
                                        IsEnabled="{Binding IsConnected}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Performance Info -->
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,8">
                            <TextBlock Text="{Binding BatchPerformance}" FontWeight="Bold" 
                                       FontSize="14" HorizontalAlignment="Center"/>
                        </Border>
                        
                        <!-- Results Section -->
                        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="📊 Batch Results" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding BatchResults}" FontFamily="Consolas" FontSize="12" 
                                               Background="{StaticResource SurfaceLightBrush}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" Padding="8"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Subscriptions Tab -->
                <TabItem Header="🔄 Subscriptions">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left: Subscription Controls -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="🔄 Real-Time Subscriptions" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                                <TextBlock Text="Tag Name:" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SubscribeTagName}" Margin="0,0,0,8"/>
                                <Button Content="Subscribe" Command="{Binding SubscribeCommand}"
                                        Style="{StaticResource ModernButton}" Margin="0,0,0,8"
                                        IsEnabled="{Binding IsConnected}"/>
                                <Button Content="Unsubscribe" Command="{Binding UnsubscribeCommand}"
                                        Style="{StaticResource ErrorButton}" Margin="0,0,0,16"
                                        IsEnabled="{Binding IsConnected}"/>
                                <TextBlock Text="Active Subscriptions:" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding Subscriptions}" Height="200"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Right: Subscription Values -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📊 Subscription Values" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SubscriptionValues}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tag" Binding="{Binding TagName}" Width="*"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                        <DataGridTextColumn Header="Updated" Binding="{Binding Updated, StringFormat='HH:mm:ss'}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Program Tags Tab -->
                <TabItem Header="📋 Program Tags">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Controls -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📋 Program-Scoped Tags" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Program Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding ProgramName}" Width="200" Margin="0,0,8,0"/>
                                    <Button Content="Discover Program Tags" Command="{Binding DiscoverProgramTagsCommand}"
                                            Style="{StaticResource ModernButton}" Margin="0,0,8,0"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <TextBlock Text="Tag Name:" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                    <TextBox Text="{Binding ProgramTagName}" Width="200" Margin="0,0,8,0"/>
                                    <Button Content="Read Tag" Command="{Binding ReadProgramTagCommand}"
                                            Style="{StaticResource ModernButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Results -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16">
                            <DataGrid ItemsSource="{Binding ProgramTags}" 
                                      AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tag Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto"/>
                                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Detailed Discovery Tab -->
                <TabItem Header="🔍 Detailed Discovery">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Controls -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Discover All Tags (Detailed)" Command="{Binding DiscoverDetailedCommand}"
                                        Style="{StaticResource ModernButton}" Margin="0,0,16,0"
                                        IsEnabled="{Binding IsConnected}"/>
                                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DiscoveryFilter}" Width="200"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Results -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16">
                            <DataGrid ItemsSource="{Binding DetailedTags}" 
                                      AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tag" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto"/>
                                    <DataGridTextColumn Header="Type Code" Binding="{Binding TypeCode}" Width="Auto"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto"/>
                                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="Auto"/>
                                    <DataGridCheckBoxColumn Header="Readable" Binding="{Binding Readable}" Width="Auto"/>
                                    <DataGridCheckBoxColumn Header="Writable" Binding="{Binding Writable}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Health & Cache Tab -->
                <TabItem Header="⚙️ Health &amp; Cache">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Health Monitoring -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="⚙️ Health Monitoring" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                                <TextBlock Text="{Binding HealthStatus}" FontSize="14" FontWeight="Bold" 
                                           Foreground="{Binding HealthStatusColor}" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="Check Health" Command="{Binding CheckHealthCommand}"
                                            Style="{StaticResource ModernButton}" Margin="0,0,8,0"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Check Health (Detailed)" Command="{Binding CheckHealthDetailedCommand}"
                                            Style="{StaticResource ModernButton}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HealthInfo}" TextWrapping="Wrap" 
                                           FontFamily="Consolas" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Cache Management -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="6" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🗑️ Cache Management" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                                <Button Content="Clear All Caches" Command="{Binding ClearCacheCommand}"
                                        Style="{StaticResource WarningButton}" Margin="0,0,0,16"
                                        IsEnabled="{Binding IsConnected}"/>
                                <Button Content="Refresh Cache Info" Command="{Binding RefreshCacheCommand}"
                                        Style="{StaticResource ModernButton}" Margin="0,0,0,16"
                                        IsEnabled="{Binding IsConnected}"/>
                                <TextBlock Text="{Binding CacheInfo}" TextWrapping="Wrap" 
                                           FontFamily="Consolas" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
