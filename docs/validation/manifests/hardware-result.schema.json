{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust EtherNet/IP hardware validation result",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "date",
    "repository_commit",
    "library_version",
    "target",
    "scope",
    "bindings",
    "restore",
    "result"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "type": "string", "pattern": "^docs/validation/.+\\.md$" },
    "date": { "type": "string", "format": "date" },
    "repository_commit": { "type": "string", "minLength": 7 },
    "library_version": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["family", "catalog", "firmware", "topology"],
      "properties": {
        "family": { "type": "string" },
        "catalog": { "type": "string" },
        "firmware": { "type": "string" },
        "topology": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["manifest", "total_paths", "writeable_paths", "read_only_paths"],
      "properties": {
        "manifest": { "type": "string" },
        "total_paths": { "type": "integer", "minimum": 0 },
        "writeable_paths": { "type": "integer", "minimum": 0 },
        "read_only_paths": { "type": "integer", "minimum": 0 }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string" },
          "result": { "enum": ["pass", "fail", "blocked", "not-run"] }
        }
      }
    },
    "restore": { "enum": ["verified", "settled", "not-required", "failed", "unknown"] },
    "result": { "enum": ["pass", "fail", "blocked"] }
  }
}
