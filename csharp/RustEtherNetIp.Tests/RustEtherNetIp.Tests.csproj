<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RustEtherNetIp\RustEtherNetIp.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <NativeLibraryFileName>librust_ethernet_ip.dylib</NativeLibraryFileName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <NativeLibraryFileName>rust_ethernet_ip.dll</NativeLibraryFileName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <NativeLibraryFileName>librust_ethernet_ip.so</NativeLibraryFileName>
  </PropertyGroup>

  <Target Name="CopyRustEtherNetIp" AfterTargets="Build">
    <Copy SourceFiles="..\RustEtherNetIp\bin\$(Configuration)\net10.0\RustEtherNetIp.dll" DestinationFolder="$(OutputPath)" />
    <Copy Condition="$([MSBuild]::IsOSPlatform('OSX'))" SourceFiles="..\..\target\release\librust_ethernet_ip.dylib" DestinationFolder="$(OutputPath)" />
    <Copy Condition="$([MSBuild]::IsOSPlatform('Windows'))" SourceFiles="..\..\target\release\rust_ethernet_ip.dll" DestinationFolder="$(OutputPath)" />
    <Copy Condition="$([MSBuild]::IsOSPlatform('Linux'))" SourceFiles="..\..\target\release\librust_ethernet_ip.so" DestinationFolder="$(OutputPath)" />
    <Message Text="Copying native library to $(OutputPath)" Importance="high" />
  </Target>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="..\..\target\release\librust_ethernet_ip.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>librust_ethernet_ip.dylib</Link>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="..\..\target\release\librust_ethernet_ip.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>librust_ethernet_ip.so</Link>
    </None>
  </ItemGroup>

</Project>
