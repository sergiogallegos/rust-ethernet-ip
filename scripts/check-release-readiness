#!/usr/bin/env python3
"""Check release version parity, packaged docs, and cargo package readiness."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

PACKAGE_ORDER = [
    "rust-ethernet-ip-types",
    "rust-ethernet-ip-tag-path",
    "rust-ethernet-ip-protocol",
    "rust-ethernet-ip-udt",
    "rust-ethernet-ip",
]
EXAMPLE_PREFIX = "examples/"
DEVELOPMENT_EXEMPT_SITES = {
    ("CHANGELOG.md", "latest [X.Y.Z] heading"),
    ("README.md", "current stable release"),
    ("README.md", "Rust install snippet"),
    ("csharp/RustEtherNetIp/README.md", "current published package"),
    ("csharp/RustEtherNetIp/README.md", "dotnet install snippet"),
    ("python/README.md", "latest published PyPI package"),
    ("python/README.md", "pip install snippet"),
    ("docs/VERSION_MANAGEMENT.md", "current stable published version"),
    ("docs/OFFICIAL_SOURCES.md", "current stable line"),
    ("docs/programmer_manual.md", "current published stable line"),
    ("docs/SOFTWARE_ARCHITECTURE.md", "current released line"),
    ("docs/agents/board.md", "current released version"),
    ("docs/CODEX_PYTHON_PLATFORM_EXPANSION_PROMPT.md", "latest published release"),
    ("docs/LIBRARY_COMPARISON_AND_IMPROVEMENTS.md", "latest published release"),
    ("wiki/controllers/firmware-behavior.md", "current release evidence"),
    ("wiki/wrapper-parity/rust-vs-csharp.md", "current parity evidence"),
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", help="expected version, e.g. 1.0.0")
    parser.add_argument("--root", default=".", help="repository root")
    parser.add_argument("--strict", action="store_true", help="fail on pre-publish dependency resolution gaps")
    parser.add_argument(
        "--development",
        action="store_true",
        help="allow registry-facing docs to remain on the published version while main prepares this version",
    )
    parser.add_argument("--ignore-examples", action="store_true", help="skip demo .csproj version checks")
    parser.add_argument("--skip-package", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args()


def expected_value(template: str, version: str) -> str:
    major, minor, patch = version.split(".")
    return template.format(version=version, major=major, minor=minor, patch=patch)


def read_manifest(root: Path) -> list[tuple[str, str, str, str, str]]:
    manifest = root / "scripts/check-release-readiness.txt"
    rows = []
    for line in manifest.read_text(encoding="utf-8").splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split("|", 4)
        if len(parts) != 5:
            raise SystemExit(f"{manifest}: malformed row: {line}")
        rows.append(tuple(parts))  # type: ignore[arg-type]
    return rows


def check_versions(args: argparse.Namespace) -> int:
    root = Path(args.root).resolve()
    failures = 0
    print(f"{'file':<52} {'site':<34} {'expected':<12} {'actual':<12} ok")
    for kind, rel, label, pattern, template in read_manifest(root):
        if args.ignore_examples and rel.startswith(EXAMPLE_PREFIX):
            continue
        path = root / rel
        expected = expected_value(template, args.version)
        actual = "<missing>"
        ok = False
        if path.exists():
            text = path.read_text(encoding="utf-8").strip() if kind == "content" else path.read_text(encoding="utf-8")
            if kind == "content":
                actual = text
                ok = actual == expected
            elif kind == "regex":
                match = re.search(pattern, text)
                if match:
                    actual = match.group(1)
                    ok = actual == expected
                else:
                    actual = "<not found>"
            else:
                raise SystemExit(f"unknown manifest kind: {kind}")
        development_pending = (
            args.development
            and not ok
            and (rel, label) in DEVELOPMENT_EXEMPT_SITES
            and re.match(r"^\d+\.\d+\.\d+$", actual) is not None
        )
        if not ok and not development_pending:
            failures += 1
        mark = "✓" if ok else ("~" if development_pending else "✗")
        print(f"{rel:<52} {label:<34} {expected:<12} {actual:<12} {mark}")
    if args.development:
        markers = [
            (
                "CHANGELOG.md",
                rf"Target release:\s*`{re.escape(args.version)}`",
                "Unreleased target",
            ),
            (
                "README.md",
                rf"Next patch in preparation:\s*`{re.escape(args.version)}`",
                "development-line marker",
            ),
        ]
        for rel, pattern, label in markers:
            text = (root / rel).read_text(encoding="utf-8")
            ok = re.search(pattern, text) is not None
            if not ok:
                failures += 1
            mark = "✓" if ok else "✗"
            print(f"{rel:<52} {label:<34} {args.version:<12} {'present' if ok else 'missing':<12} {mark}")
    return failures


def package_checks(args: argparse.Namespace) -> int:
    if args.skip_package:
        return 0
    failures = 0
    root = Path(args.root).resolve()
    print()
    print(f"{'package check':<52} result")
    for package in PACKAGE_ORDER:
        cmd = ["cargo", "package", "--no-verify", "--allow-dirty", "-p", package]
        env = os.environ.copy()
        env.setdefault("CARGO_NET_RETRY", "0")
        proc = subprocess.run(cmd, cwd=root, text=True, capture_output=True, env=env)
        output = f"{proc.stdout}\n{proc.stderr}"
        missing_dep = (
            "no matching package named" in output
            or "failed to select a version for the requirement" in output
        ) and "location searched: crates.io index" in output
        index_unavailable = "Could not resolve host" in output or "failed to download from `https://index.crates.io" in output
        if proc.returncode == 0:
            artifact = root / "target" / "package" / f"{package}-{args.version}.crate"
            docs_cmd = [
                sys.executable,
                str(root / "scripts" / "check-packaged-release-docs"),
                args.version,
            ]
            if package == "rust-ethernet-ip":
                docs_cmd.append("--require-version-marker")
            docs_cmd.append(str(artifact))
            docs_proc = subprocess.run(
                docs_cmd,
                cwd=root,
                text=True,
                capture_output=True,
            )
            if docs_proc.returncode == 0:
                print(f"{package:<52} ✓")
            else:
                failures += 1
                print(f"{package:<52} ✗ packaged README")
                sys.stderr.write(f"{docs_proc.stdout}{docs_proc.stderr}")
        elif missing_dep and not args.strict:
            print(f"{package:<52} note: dependency not yet visible on crates.io")
        elif index_unavailable and not args.strict:
            print(f"{package:<52} note: crates.io index unavailable")
        else:
            failures += 1
            print(f"{package:<52} ✗")
            sys.stderr.write(output)
    return failures


def main() -> int:
    args = parse_args()
    if not re.match(r"^\d+\.\d+\.\d+$", args.version):
        print("version must be MAJOR.MINOR.PATCH", file=sys.stderr)
        return 2
    failures = check_versions(args)
    failures += package_checks(args)
    if failures:
        print(f"\ncheck-release-readiness: {failures} failure(s)", file=sys.stderr)
        return 1
    print("\ncheck-release-readiness: ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
